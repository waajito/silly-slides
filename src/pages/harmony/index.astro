<style lang="scss">
  .container {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background-color: rgb(254, 245, 232);
    justify-content: center;
    align-items: center;
  }
  .tube-holder {
    display: flex;
    align-items: end;
    gap: 4px;
    height: 600px;
    &:hover {
      .tube {
        opacity: 0.5;
      }
    }
  }

  .tube {
    width: 40px;
    height: 300px;
    border-radius: 120px;
    background-color: #333;
    transition: all 0.4s cubic-bezier(0.075, 0.82, 0.165, 1);

    &:hover {
      opacity: 1 !important;
      height: 450px;
    }
    &:hover + .tube {
      opacity: 1 !important;
      height: 400px;
    }

    &:hover + * + .tube {
      opacity: 1 !important;
      height: 350px;
    }
  }
</style>
