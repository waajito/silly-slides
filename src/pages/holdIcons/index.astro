---
import SiteLayout from "../../layouts/SiteLayout.astro";
// import IconCard from "./iconCard.astro";
import IconCard from "./iconCard.svelte";
---

<SiteLayout title="Hold Icons">
  <div class="container">
    <h1>Icons Holds</h1>
    <div class="scroll-container">
      <IconCard client:load iconUrl="/icons/clipboard.svg" name="Clipboard" />
      <IconCard client:load iconUrl="/icons/confetti-minimalistic.svg" name="Confetti" />
      <IconCard client:load iconUrl="/icons/download-square.svg" name="Download" />
      <IconCard client:load iconUrl="/icons/exit.svg" name="Exit" />
      <IconCard client:load iconUrl="/icons/heart-angle.svg" name="Like" />
      <IconCard client:load iconUrl="/icons/medal-star-square.svg" name="Medal" />
      <IconCard client:load iconUrl="/icons/palette-round.svg" name="Palette" />
      <IconCard client:load iconUrl="/icons/qr-code.svg" name="QR Code" />
      <IconCard client:load iconUrl="/icons/colour-tuneing.svg" name="Tuneing" />
    </div>
  </div>
</SiteLayout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap");

  * {
    font-family: "Noto Sans", sans-serif;
    margin: 0;
  }
  .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100vh;
    gap: 2rem;
  }
  .scroll-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    max-width: 400px;
  }
</style>
